# ─────────────────────────────────────────────────────────────────────────────
# deRuedas Gestion — plantilla de variables de entorno
#
# Tabla canonica: docs/adr/ADR-013-variables-de-entorno.md
# 35 variables en 12 grupos. Los grupos coinciden uno a uno con las clases
# de backend/app/config.py (T-004).
#
# COMO USARLO
#   cp .env.example .env   y completa los valores reales en .env
#   .env esta en .gitignore y NUNCA se versiona.
#
# TODOS LOS VALORES DE ESTE ARCHIVO SON FICTICIOS.
#   Constitucion Art. 3: los secretos no viven en el repositorio. Los reales
#   se cargan desde AWS Secrets Manager / Google Secret Manager.
#   Marcados con [SENSIBLE] los 15 campos que se enmascaran en logs, repr,
#   serializacion y mensajes de error.
#
# La aplicacion MUERE AL ARRANCAR si falta una variable obligatoria o si el
# tipo no valida, y el mensaje nombra la variable (T-004).
# ─────────────────────────────────────────────────────────────────────────────


# ── AppSettings ──────────────────────────────────────────────────────────────
# APP_ENV solo admite: local | ci | staging | production
# Cualquier otro valor se rechaza al arrancar. Ojo: la variable es APP_ENV,
# no ENVIRONMENT — ver ADR-013, seccion "Las dos correcciones".
APP_ENV=local
API_BASE_URL=http://localhost:8000
# Origenes permitidos para CORS, separados por coma.
CORS_ORIGINS=http://localhost:3000

# ── DatabaseSettings ─────────────────────────────────────────────────────────
# DOS URLS, DOS ROLES (ADR-020). No es redundancia:
#
#   DATABASE_URL            rol de APLICACION. NOSUPERUSER, NOBYPASSRLS, sin
#                           DDL y sin DELETE. Es el unico que atiende trafico, y
#                           por no poder saltear RLS es lo que hace que la capa 2
#                           del aislamiento multi-tenant exista de verdad.
#
#   DATABASE_MIGRATION_URL  rol PROPIETARIO del esquema. Solo lo usa alembic.
#                           Crear tablas y politicas es justamente lo que el rol
#                           de aplicacion NO debe poder hacer.
#
# Las dos tienen que apuntar a la MISMA base: solo cambia el usuario. alembic lo
# verifica al arrancar y muere si no coinciden en host, puerto o nombre de base.
#
# [SENSIBLE] Lleva credenciales embebidas en la URL.
# Driver asyncpg: el backend es async de punta a punta (ADR-003).
DATABASE_URL=postgresql+asyncpg://mitutu:cambiame@localhost:5432/deruedas
# [SENSIBLE] Opcional: solo la necesita el proceso que migra. El backend que
# atiende peticiones y el worker NO deben tener la credencial del propietario.
DATABASE_MIGRATION_URL=postgresql+asyncpg://deruedas:cambiame@localhost:5432/deruedas
# Headroom <= 60 % sobre max_connections de PostgreSQL.
DATABASE_POOL_SIZE=20

# ── RedisSettings ────────────────────────────────────────────────────────────
# Cache, Redis Streams y Pub/Sub (ADR-009).
REDIS_URL=redis://localhost:6379/0
# Base distinta a la de cache: aisla la cola de Celery del cache de aplicacion.
CELERY_BROKER_URL=redis://localhost:6379/1

# ── SearchSettings ───────────────────────────────────────────────────────────
# OpenSearch para busqueda full-text y catalogo (ADR-011).
OPENSEARCH_URL=http://localhost:9200
# [SENSIBLE]
OPENSEARCH_USER=admin
# [SENSIBLE]
OPENSEARCH_PASSWORD=cambiame

# ── KeycloakSettings ─────────────────────────────────────────────────────────
# La autenticacion se delega ENTERAMENTE a Keycloak (ADR-007, Art. 3).
# La aplicacion nunca recibe, hashea ni verifica una contrasena.
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=deruedas-dev
KEYCLOAK_CLIENT_ID=backend
# [SENSIBLE] Secreto del client confidential.
KEYCLOAK_CLIENT_SECRET=cambiame
# Endpoint de claves publicas para verificar la firma RS256.
# Se usa el JWKS URL, no una clave embebida: permite rotacion sin deploy.
KEYCLOAK_JWKS_URL=http://localhost:8080/realms/deruedas-dev/protocol/openid-connect/certs
# El `iss` que traen los tokens: el hostname PUBLICO, por el que el navegador
# pide el token — que NO siempre es KEYCLOAK_URL, la URL interna con la que el
# backend habla con Keycloak. Si difieren, todo responde 401 y parece un
# problema de firma. Ver ADR-013 seccion 2.b.
KEYCLOAK_ISSUER=http://localhost:8080/realms/deruedas-dev

# ── S3Settings ───────────────────────────────────────────────────────────────
# Object storage S3-compatible; MinIO en desarrollo local (ADR-008).
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=deruedas-media
# [SENSIBLE]
S3_ACCESS_KEY=minioadmin
# [SENSIBLE]
S3_SECRET_KEY=cambiame
CDN_BASE_URL=http://localhost:9000/deruedas-media

# ── WhatsAppSettings ─────────────────────────────────────────────────────────
# WhatsApp Business Cloud API de Meta, directo, sin BSP (ADR-010).
# [SENSIBLE] Valida la firma HMAC de los webhooks entrantes.
WHATSAPP_APP_SECRET=cambiame
# [SENSIBLE] Token del handshake de verificacion del webhook.
WHATSAPP_VERIFY_TOKEN=cambiame

# ── CryptoSettings ───────────────────────────────────────────────────────────
# [SENSIBLE] Master key AES-GCM para cifrar los secretos de cada tenant.
# En staging y produccion NO se pasa por variable: vive en KMS.
TENANT_SECRETS_MASTER_KEY=cambiame
# [SENSIBLE] Identificador de la clave en el KMS del proveedor cloud.
KMS_KEY_ID=cambiame

# ── PaymentSettings ──────────────────────────────────────────────────────────
# [SENSIBLE] Mercado Pago: cobros y suscripciones.
MERCADOPAGO_ACCESS_TOKEN=TEST-0000000000000000-000000-cambiame

# ── ObservabilitySettings ────────────────────────────────────────────────────
# [SENSIBLE] Sentry. Vacio desactiva el reporte de errores.
SENTRY_DSN=
# Exportador OTLP. Apunta a Tempo, no a Jaeger (ADR-016). El nombre no cambia:
# OpenTelemetry es agnostico del backend, y eso mantiene la decision reversible.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# Ratio de sampling de trazas. 1.0 en local; 0.001 en produccion.
OTEL_TRACES_SAMPLER_ARG=1.0
LOG_LEVEL=INFO

# ── MailSettings ─────────────────────────────────────────────────────────────
# Mailhog en desarrollo local: captura los mails sin enviarlos afuera.
SMTP_HOST=localhost:1025
# [SENSIBLE] Vacio en local: Mailhog no pide autenticacion.
SMTP_USER=
# [SENSIBLE]
SMTP_PASSWORD=

# ── Frontend (frontend-web/) ─────────────────────────────────────────────────
# Estas tres las lee Next.js, no el backend. Van en frontend-web/.env.local
# y se repiten aca para que .env.example sea el inventario completo.
# [SENSIBLE] Firma de la sesion de NextAuth. Generar con: openssl rand -base64 32
NEXTAUTH_SECRET=cambiame
NEXTAUTH_URL=http://localhost:3000
# NEXT_PUBLIC_ queda EXPUESTA en el bundle del navegador. Nunca un secreto aca.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
